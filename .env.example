# ---------------------------------------------------------------------------
# Boat Charter — environment configuration example
# Copy the values you need into the project's secure environment settings.
# NEVER commit real credentials to source control.
# ---------------------------------------------------------------------------

# Payment provider (server-side only — never exposed to the browser)
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_API_URL=
# development | production
PAYMENT_ENVIRONMENT=development

# When PAYMENT_SECRET_KEY (or PAYMENT_API_KEY) and PAYMENT_API_URL are empty the
# application runs the clearly-labelled demo payment gateway so checkout stays
# usable in development. Adding real credentials switches it to live mode with
# no code changes.

# Webhook endpoint to register with the provider:
#   POST https://<your-domain>/api/public/webhooks/payment
#   Header: x-payment-signature: sha256=<hmac-sha256 of the raw body>

# Backend (managed automatically — listed for reference only)
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
