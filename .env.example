# Supabase project configuration. The VITE_ values are included in the browser bundle.
# Use only a publishable key in VITE_ variables; never put a secret key in VITE_ vars.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only key for trusted Supabase admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-secret-key

# Optional payment settings. Leave unset to use demo mode.
# PAYMENT_PROVIDER=your-provider
# PAYMENT_API_KEY=your-payment-api-key
# PAYMENT_SECRET_KEY=your-payment-secret-key
# PAYMENT_PUBLIC_KEY=your-payment-public-key
# PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret
# PAYMENT_API_URL=https://your-payment-provider.example
# PAYMENT_ENVIRONMENT=your-environment
